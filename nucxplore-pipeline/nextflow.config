manifest {
  name = 'nucxplore-pipeline'
  description = 'Nextflow pipeline for WSI crop/filter, NucXplore segmentation, NucXplore extraction, and cell-type prediction'
  version = '0.3.0'
}

params {
  // ---- stage control ----
  stage = null
  from_stage = 'crop'
  to_stage = 'prediction'

  // ---- standalone entry inputs for upstream stages ----
  slide_root = null
  crop_root = null
  features_root = null

  // ---- input mode (features-only) ----
  input_mode = 'roots'
  image_root = null
  mat_root = null
  samplesheet = null

  // ---- crop and filtering ----
  slide_exts = '.ndpi,.svs,.tif,.tiff'
  tile_size = 1250
  mean_threshold = 220
  std_threshold = 15
  drop_partial_tiles = true
  crop_recursive = false

  // ---- NucXplore segmentation ----
  seg_batch_size = 8
  seg_patch_size = 256
  seg_stride = 80
  seg_padding = 120
  seg_device = 'cuda'
  seg_n_devices = 1
  seg_checkpoint = '/opt/heip/models/last.ckpt'

  // ---- stage-specific container images (segmentation + prediction only) ----
  seg_container = 'ahujalab/nucxplore-seg:latest'

  // ---- intermediate publish flags ----
  publish_crops = false
  publish_segmentation = false

  // ---- feature extraction params ----
  outdir = 'results/celltype'
  recursive = true
  image_exts = '.png,.jpg,.jpeg,.tif,.tiff,.bmp'
  workers = 4
  max_images = null
  skip_existing = false

  mat_key = null
  inst_type_key = 'inst_type'
  padding = 10
  use_gpu = false
  feature_schema = 'legacy'
  save_crops = true

  // ---- prediction params ----
  model_path = '/opt/nucxplore/models/xgboost_best_model.pkl'
  encoder_path = '/opt/nucxplore/models/label_encoder.pkl'

  // ---- container images ----
  container = 'ahujalab/nucxplore-cell-type-prediction:latest'
  fail_on_missing_model_features = true
}

// All container engines are opt-in via profiles.
// Docker is the default engine for containerized stages (segmentation + prediction).
docker.enabled = true
docker.runOptions = '-u $(id -u):$(id -g)'
apptainer.enabled = false
singularity.enabled = false

includeConfig 'conf/containers.config'

process {
  shell = ['/bin/bash', '-euo', 'pipefail']
  cpus = { params.workers as Integer }
  errorStrategy = 'terminate'

  withName: 'NUCXPLORE_SEG'      { maxForks = 1 }
  withName: 'PREDICT_CELL_TILES' { maxForks = 1 }
}

profiles {
  // Used only by `-stub-run` contract checks so fake image names are never pulled.
  stub {
    docker.enabled = false
    apptainer.enabled = false
    singularity.enabled = false
  }
  apptainer {
    docker.enabled = false
    apptainer.enabled = true
  }
  singularity {
    docker.enabled = false
    singularity.enabled = true
  }
}

// Conservative local defaults for early development.
executor {
  name = 'local'
}
