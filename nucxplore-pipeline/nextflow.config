manifest {
  name = 'nucxplore-pipeline'
  description = 'Nextflow pipeline for WSI crop/filter, RGCI/HEIP segmentation, NucXplore extraction, and cell-type prediction'
  version = '0.2.0'
}

params {
  // ---- stage control ----
  from_stage = 'crop'
  to_stage = 'prediction'

  // ---- standalone entry inputs for upstream stages ----
  slide_root = null
  crop_root = null
  features_root = null

  // ---- input mode (features-only) ----
  input_mode = 'roots'
  image_root = null
  mat_root = null
  samplesheet = null

  // ---- crop and filtering ----
  slide_exts = '.ndpi,.svs,.tif,.tiff'
  tile_size = 1250
  mean_threshold = 220
  std_threshold = 15
  drop_partial_tiles = true
  crop_recursive = false

  // ---- RGCI/HEIP segmentation ----
  seg_batch_size = 8
  seg_patch_size = 256
  seg_stride = 80
  seg_padding = 120
  seg_device = 'cuda'
  seg_n_devices = 1
  seg_checkpoint = '/opt/heip/models/last.ckpt'

  // ---- stage-specific container images ----
  crop_filter_container = 'docker.io/<owner>/nucxplore-crop-filter:<tag>'
  seg_container = 'docker.io/<owner>/nucxplore-rgci-seg:<tag>'

  // ---- intermediate publish flags ----
  publish_crops = false
  publish_segmentation = false

  // ---- feature extraction params ----
  outdir = 'results/celltype'
  recursive = true
  image_exts = '.png,.jpg,.jpeg,.tif,.tiff,.bmp'
  workers = 4
  max_images = null
  skip_existing = false

  mat_key = null
  inst_type_key = 'inst_type'
  padding = 10
  use_gpu = false
  save_crops = true
  save_pre_normalized_crops = true
  save_post_normalized_crops = true
  stain_normalization_features = true

  // ---- prediction params ----
  model_path = '/opt/nucxplore/models/Final_XGB_Model_FullData.pkl'
  encoder_path = '/opt/nucxplore/models/final_label_encoder.pkl'

  // ---- Docker image (fallback container for non-stage-specific processes) ----
  container = 'docker.io/<owner>/nucxplore-cell-type-prediction:<tag>'
  fail_on_missing_model_features = true
}

process {
  shell = ['/bin/bash', '-euo', 'pipefail']
  cpus = { params.workers as Integer }
  errorStrategy = 'terminate'
}

// Keep Docker opt-in via profile to match standard Nextflow behavior.
docker.enabled = false

profiles {
  docker {
    includeConfig 'conf/docker.config'
  }
}

// Conservative local defaults for early development.
executor {
  name = 'local'
}
