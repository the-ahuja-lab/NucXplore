# syntax=docker/dockerfile:1.7

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    libopenslide0 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip && \
    python -m pip install --no-cache-dir \
      "numpy>=1.24,<1.27" \
      "tiffslide>=1.1,<2.0" \
      "pillow>=10.0,<11.0" \
      "opencv-python-headless>=4.8,<4.11"

RUN adduser \
    --disabled-password \
    --gecos "" \
    --home "/nonexistent" \
    --shell "/usr/sbin/nologin" \
    --no-create-home \
    --uid "10001" \
    appuser

WORKDIR /work

COPY nucxplore-pipeline/bin/crop_and_filter.py /usr/local/bin/crop_and_filter.py
RUN chmod +x /usr/local/bin/crop_and_filter.py

USER appuser
