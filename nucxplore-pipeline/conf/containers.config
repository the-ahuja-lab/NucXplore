// Container configuration for nucxplore-pipeline.
// Only NUCXPLORE_SEG and prediction processes run in containers;
// CROP_AND_FILTER, PREPARE_SAMPLESHEET, and EXTRACT_FEATURES_PER_TILE use the local conda environment.

process {
  withName: 'NUCXPLORE_SEG' {
    container = params.seg_container
    containerOptions = params.seg_device == 'cuda' ? '--runtime=nvidia -e NVIDIA_VISIBLE_DEVICES=all -e NVIDIA_DRIVER_CAPABILITIES=compute,utility' : ''
  }
  withName: 'PREDICT_CELL_TILES' {
    container = params.container
  }
}
